{{ pii_sanitizer.host }}:
  <<: *default
  container_name: {{ pii_sanitizer.host }}
  build: ./{{ pii_sanitizer.build_dir }}
  environment:
    GUNICORN_WORKERS: "1"
  healthcheck:
    # イメージに curl が無いので python でポートだけ見る
    test: ["CMD", "python", "-c", "import socket; socket.create_connection(('localhost', {{ pii_sanitizer.port }}), 3).close()"]
    interval: 30s
    timeout: 10s
    retries: 3
    # spaCy の lg モデルを 2 言語分読み込むまで待つ
    start_period: 180s
