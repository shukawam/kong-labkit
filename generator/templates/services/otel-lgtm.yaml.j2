otel-lgtm:
  <<: *default
  container_name: otel-lgtm
  image: grafana/otel-lgtm:0.25.0
  ports:
    - {{ ports.grafana }}:3000
    - {{ ports.otlp_grpc }}:4317
    - {{ ports.otlp_http }}:4318
  # provisioning ディレクトリごと差し替えると同梱の RED metrics ダッシュボードが消えるので、
  # プロバイダ定義とダッシュボード置き場だけを足す。置き場が conf/provisioning の外にあると
  # Grafana の permitted_provisioning_paths に弾かれる
  volumes:
    - ./config/otel-lgtm/otelcol-config.yaml:/otel-lgtm/otelcol-config.yaml:ro
    - ./config/grafana/dashboards.yaml:/otel-lgtm/grafana/conf/provisioning/dashboards/kong.yaml:ro
    - ./config/grafana/dashboards:/otel-lgtm/grafana/conf/provisioning/dashboards/kong:ro
