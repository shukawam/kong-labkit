_format_version: "3.0"
{% macro auth_plugin() %}
{% if idp.auth_plugin == 'openid-connect' %}
      - name: openid-connect
        config:
          issuer: '{{ idp.issuer }}'
          client_id:
            - '{{ idp.client_id }}'
          client_secret:
            - '{{ idp.client_secret }}'
          # decK が明示値なしの sync を拒否するため固定値を設定する
          cache_tokens_salt: local-dev-salt
          auth_methods:
            - bearer
            - client_credentials
{% elif idp.auth_plugin == 'ldap-auth-advanced' %}
      - name: ldap-auth-advanced
        config:
          ldap_host: {{ idp.ldap.host }}
          ldap_port: 3890
          # 検索してから bind するので、ユーザーの DN を組み立てる必要がない
          bind_dn: {{ idp.ldap.bind_dn }}
          ldap_password: {{ idp.ldap.bind_password }}
          base_dn: {{ idp.ldap.users_dn }}
          attribute: {{ idp.ldap.attribute }}
          header_type: ldap
          # lldap は平文 LDAP のみを listen する
          ldaps: false
          start_tls: false
          verify_ldap_host: false
          cache_ttl: 60
          # Consumer が無いユーザーも通す。認証と Consumer 割り当てを別々に試せる
          consumer_optional: true
          consumer_by:
            - username
          group_base_dn: {{ idp.ldap.groups_dn }}
          group_name_attribute: cn
          group_member_attribute: member
{% endif %}
{% endmacro %}

{% if spec.gateway.value == 'ai-gateway-v1' or upstream.enabled %}
services:
{% else %}
services: []
{% endif %}
{% if spec.gateway.value == 'ai-gateway-v1' %}
  - name: llm
    # ai-proxy-advanced が上流を差し替えるが、service には URL が必須なので捨て値を置く
    url: http://localhost:32000
    routes:
      - name: chat
        paths:
          - /v1/chat/completions
        methods:
          - POST
        strip_path: false
        # 省略すると平文 HTTP が 426 で弾かれる（decK/Kong のルート protocols 既定値は https のみ）
        protocols:
          - http
          - https
    plugins:
      - name: ai-proxy-advanced
        config:
          targets:
{% for provider in spec.ai.providers %}
{% set provider_auth = deck.provider_auth[loop.index0] %}
{% for model in provider.models %}
            - route_type: llm/v1/chat
              auth:
{% for key, value in provider_auth.items() %}
                {{ key }}: {{ value }}
{% endfor %}
              model:
                provider: {{ provider.type.value }}
                name: {{ model.name }}
                options:
{% if provider.instance %}
                  azure_instance: {{ provider.instance }}
{% endif %}
{% if model.deployment_id %}
                  azure_deployment_id: {{ model.deployment_id }}
{% endif %}
{% if model.api_version %}
                  azure_api_version: "{{ model.api_version }}"
{% endif %}
{% endfor %}
{% endfor %}
{% if semantic.cache %}
      - name: ai-semantic-cache
        config:
          embeddings:
            auth:
{% for key, value in deck.embeddings_auth.items() %}
              {{ key }}: {{ value }}
{% endfor %}
            model:
              provider: {{ deck.embeddings_provider }}
              name: {{ spec.ai.embedding_model }}
          vectordb:
            strategy: {{ 'redis' if vector.type.value == 'redis-stack' else 'pgvector' }}
            dimensions: {{ vector.dimensions }}
            distance_metric: {{ vector.distance_metric }}
            threshold: {{ vector.threshold }}
{% if vector.type.value == 'redis-stack' %}
            redis:
              host: {{ vector.host }}
              port: {{ vector.port }}
{% else %}
            pgvector:
              host: {{ vector.host }}
              port: {{ vector.port }}
              database: {{ vector.database }}
              user: {{ vector.user }}
              password: {{ vector.password }}
{% endif %}
{% endif %}
{% if idp.enabled %}
{{ auth_plugin() -}}
{% endif %}
{% elif upstream.enabled %}
  - name: {{ upstream.service_name }}
    url: {{ upstream.url }}
    routes:
      - name: {{ upstream.service_name }}
        paths:
          - /{{ upstream.service_name }}
        strip_path: true
        # 省略すると平文 HTTP が 426 で弾かれる（decK/Kong のルート protocols 既定値は https のみ）
        protocols:
          - http
          - https
{% if idp.enabled %}
    plugins:
{{ auth_plugin() -}}
{% endif %}
{% endif %}

{% if idp.type.value == 'ldap' %}
# ldap-auth-advanced の consumer_by が突き合わせる先。LDAP の認証成功だけでは Consumer は生えない
consumers:
{% for user in idp.ldap.users %}
  - username: {{ user.name }}
{% endfor %}

{% endif %}
{% if otel.enabled %}
plugins:
  - name: opentelemetry
    config:
      traces_endpoint: {{ otel.endpoint }}/v1/traces
      logs_endpoint: {{ otel.endpoint }}/v1/logs
      resource_attributes:
        service.name: {{ kong.cp_name }}
{% else %}
plugins: []
{% endif %}
