_defaults:
  kongctl:
    namespace: {{ namespace }}

{% if spec.control_plane.value == 'self-managed' %}
# self-managed の Control Plane は compose.yaml で作成するため、Konnect リソースは定義しません。
# Gateway 設定は config/kong/kong.yaml を mise run sync で適用します。
{% elif spec.gateway.value != 'ai-gateway-v2' %}
control_planes:
  - ref: {{ kong.cp_name }}
    name: {{ kong.cp_name }}
    cluster_type: CLUSTER_TYPE_CONTROL_PLANE
    auth_type: pinned_client_certs
    data_plane_certificates:
      - ref: {{ kong.cp_name }}-cert
        cert: !file ../{{ certs.crt_path }}
    _deck:
      files:
        - kong/kong.yaml
{% else %}
ai_gateways:
  - ref: {{ kong.cp_name }}
    name: {{ kong.cp_name }}
    display_name: {{ kong.cp_name }}
    deployment_type: hybrid

    model_providers:
{% for provider in spec.ai.providers %}
      - ref: {{ provider.type.value }}
        ai_gateway: !ref {{ kong.cp_name }}#id
        name: {{ provider.type.value }}
        type: {{ provider.type.value }}
        display_name: {{ provider.type.value }}
        config:
{% if provider.instance %}
          instance: {{ provider.instance }}
{% endif %}
{% if provider.type.value == 'azure' and provider.auth.value == 'managed-identity' %}
          auth:
            type: azure
            use_managed_identity: true
            client_id: !env AZURE_CLIENT_ID
            tenant_id: !env AZURE_TENANT_ID
{% elif provider.type.value == 'azure' %}
          auth:
            type: basic
            headers:
              - name: api-key
                value: !env AZURE_OPENAI_API_KEY
{% elif provider.type.value == 'openai' %}
          auth:
            type: bearer
            token: !env OPENAI_API_KEY
{% elif provider.type.value == 'anthropic' %}
          auth:
            type: basic
            headers:
              - name: x-api-key
                value: !env ANTHROPIC_API_KEY
{% elif provider.type.value == 'bedrock' %}
          auth:
            type: aws
            access_key_id: !env AWS_ACCESS_KEY_ID
            secret_access_key: !env AWS_SECRET_ACCESS_KEY
{% if provider.auth.value == 'session-token' %}
            session_token: !env AWS_SESSION_TOKEN
{% endif %}
{% else %}
          auth:
            type: {{ provider.type.value }}
{% endif %}
{% endfor %}

    models:
{% for provider in spec.ai.providers %}
{% for model in provider.models %}
      - ref: {{ model.name }}
        ai_gateway: !ref {{ kong.cp_name }}#id
        name: {{ model.name }}
        display_name: {{ model.name }}
        type: model
        enabled: true
{% if prompt_compressor.enabled and provider.type.value != 'bedrock' %}
        policies:
          - ai-prompt-compressor
{% endif %}
        capabilities:
          - generate
        formats:
          - type: openai
        targets:
          - name: {{ model.model_id or model.name }}
            provider: {{ provider.type.value }}
            weight: 100
            config:
              type: {{ provider.type.value }}
{% if model.deployment_id %}
              deployment_id: {{ model.deployment_id }}
{% endif %}
{% if model.api_version %}
              api_version: {{ model.api_version }}
{% endif %}
{% if provider.region %}
              region: {{ provider.region }}
{% endif %}
        config:
          model:
            name_header: true
          response_streaming: allow
          # v1 の log_payloads に相当。v2 でのフィールド名は payloads で、log_payloads は弾かれる。
          # プロンプトと応答本文をそのままスパンに載せるので、検証環境だけの設定
          logging:
            payloads: true
{% if semantic.enabled %}
          balancer:
            algorithm: semantic
            embeddings:
              name: {{ spec.ai.embedding_model }}
              provider: {{ provider.type.value }}
              allow_auth_override: false
              config:
                type: {{ provider.type.value }}
            vectordb:
              type: {{ 'redis' if vector.type.value == 'redis-stack' else 'pgvector' }}
              host: {{ vector.host }}
              port: {{ vector.port }}
{% if vector.type.value == 'pgvector' %}
              database: {{ vector.database }}
              user: {{ vector.user }}
              password: {{ vector.password }}
{% endif %}
              dimensions: {{ vector.dimensions }}
              threshold: {{ vector.threshold }}
              distance_metric: {{ vector.distance_metric }}
{% endif %}
          route:
            paths:
              - /v1/{{ model.name }}
            protocols:
              - http
              - https
            strip_path: true
{% endfor %}
{% endfor %}
{% if prompt_guard.enabled or prompt_compressor.enabled or otel.enabled %}

    policies:
{% if prompt_guard.enabled %}
      - ref: {{ kong.cp_name }}-ai-prompt-guard
        ai_gateway: !ref {{ kong.cp_name }}#id
        name: ai-prompt-guard
        display_name: AI Prompt Guard
        type: ai-prompt-guard
        global: true
        enabled: true
        config:
          llm_format: {{ prompt_guard.llm_format }}
          continue_on_detection: {{ 'true' if prompt_guard.continue_on_detection else 'false' }}
          rejection_mode: {{ prompt_guard.rejection_mode }}
          deny_patterns:
{% for pattern in prompt_guard.patterns %}
            - '{{ pattern }}'
{% endfor %}
{% endif %}
{% if prompt_compressor.enabled %}
      - ref: {{ kong.cp_name }}-ai-prompt-compressor
        ai_gateway: !ref {{ kong.cp_name }}#id
        name: ai-prompt-compressor
        display_name: AI Prompt Compressor
        type: ai-prompt-compressor
        # global にすると ai-proxy-advanced の SigV4 署名後に body を書き戻し、Bedrock が必ず 403 になる。
        # models[].policies で bedrock 以外にだけ付ける
        global: false
        enabled: true
        config:
          provider: kong
          # DP と同じ compose ネットワーク上のコンテナ。パスはプラグイン側が付ける
          compressor_url: http://{{ prompt_compressor.host }}:{{ prompt_compressor.port }}
          compressor_type: rate
          # 短いプロンプトは圧縮すると意味が崩れやすいので触らず、長いほど強く圧縮する
          compression_ranges:
{% for min_tokens, max_tokens, value in prompt_compressor.ranges %}
            - min_tokens: {{ min_tokens }}
              max_tokens: {{ max_tokens }}
              value: {{ value }}
{% endfor %}
          message_type:
            - user
          # CPU 推論は長いプロンプトで既定の 10 秒を超える
          timeout: {{ prompt_compressor.timeout_ms }}
          keepalive_timeout: {{ prompt_compressor.keepalive_timeout_ms }}
          log_text_data: true
          stop_on_error: false
{% endif %}
{% if otel.enabled %}
      - ref: {{ kong.cp_name }}-opentelemetry
        ai_gateway: !ref {{ kong.cp_name }}#id
        name: opentelemetry
        display_name: OpenTelemetry
        type: opentelemetry
        global: true
        enabled: true
        config:
          traces_endpoint: {{ otel.endpoint }}/v1/traces
          # logs_endpoint が運ぶのは Kong 内部のエラーログだけ。
          # アクセスログはプラグイン内の別エクスポータで、これを設定しないと出ない。
          # 平坦な access_logs_endpoint は非推奨なのでレコード側に書く
          logs_endpoint: {{ otel.endpoint }}/v1/logs
          access_logs:
            endpoint: {{ otel.endpoint }}/v1/logs
          # Grafana のダッシュボードはここから出る OTLP メトリクスだけを見ている。
          # Prometheus プラグインは使わない
          metrics:
            endpoint: {{ otel.endpoint }}/v1/metrics
            push_interval: {{ otel.metrics_push_interval }}
            enable_request_metrics: true
            enable_latency_metrics: true
            enable_bandwidth_metrics: true
            enable_upstream_health_metrics: true
            enable_consumer_attribute: true
            enable_ai_metrics: true
          resource_attributes:
            service.name: {{ kong.cp_name }}
{% endif %}
{% endif %}

    data_plane_certificates:
      - ref: {{ kong.cp_name }}-cert
        ai_gateway: !ref {{ kong.cp_name }}#id
        title: Cluster Certificate
        description: Cluster certificate for {{ kong.cp_name }}
        cert: !file ../{{ certs.crt_path }}
{% endif %}
