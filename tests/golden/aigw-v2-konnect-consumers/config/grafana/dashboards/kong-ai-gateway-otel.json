{
  "uid": "kong-ai-gateway-otel",
  "title": "Kong AI Gateway (OpenTelemetry)",
  "description": "Konnect の AI gateway dashboard 相当の情報を、opentelemetry プラグインの gen_ai.* / kong.gen_ai.* OTLP メトリクスで再構成したもの。",
  "tags": [
    "kong",
    "opentelemetry",
    "ai"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds",
        "label": "Datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "regex": "",
        "multi": false,
        "includeAll": false
      },
      {
        "type": "query",
        "name": "provider",
        "label": "Provider",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "definition": "label_values(gen_ai_client_operation_duration_seconds_count,gen_ai_provider_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(gen_ai_client_operation_duration_seconds_count,gen_ai_provider_name)",
          "refId": "provider"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": ""
      },
      {
        "type": "query",
        "name": "model",
        "label": "Model",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "definition": "label_values(gen_ai_client_operation_duration_seconds_count,gen_ai_request_model)",
        "query": {
          "qryType": 1,
          "query": "label_values(gen_ai_client_operation_duration_seconds_count,gen_ai_request_model)",
          "refId": "model"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": ""
      },
      {
        "type": "query",
        "name": "consumer",
        "label": "Consumer",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "definition": "label_values(gen_ai_client_operation_duration_seconds_count,kong_auth_consumer_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(gen_ai_client_operation_duration_seconds_count,kong_auth_consumer_name)",
          "refId": "consumer"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": ""
      },
      {
        "type": "query",
        "name": "service",
        "label": "AI Service",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "definition": "label_values(http_server_request_count_total,kong_service_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(http_server_request_count_total,kong_service_name)",
          "refId": "service"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": ""
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "サマリ",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "AI Gateway リクエスト総数",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "sum(increase(gen_ai_client_operation_duration_seconds_count{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\"}[$__range]))",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series",
          "legendFormat": "Request count"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 48
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "累計コスト ($)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "sum(increase(kong_gen_ai_llm_cost_total{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\"}[$__range]))",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series",
          "legendFormat": "Costs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 48
        }
      },
      "description": "ai-proxy-advanced の target に model.options.input_cost / output_cost （100 万トークンあたりの USD）が設定されていないと 0 のままになる。さらに OTLP 上は整数として送られるため、1 ドル未満は 0 に丸められる。金額を実際に見るときはコスト用ダッシュボードのトークン単価からの試算を使う。"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "総トークン数",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "sum(increase(gen_ai_client_token_usage_total{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\", gen_ai_token_type=\"total\"}[$__range]))",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series",
          "legendFormat": "tokens"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 48
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "LLM レイテンシ 平均",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "sum(rate(gen_ai_server_request_duration_seconds_sum{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\"}[$__range])) / clamp_min(sum(rate(gen_ai_server_request_duration_seconds_count{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\"}[$__range])), 0.0000001)",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series",
          "legendFormat": "avg"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 48
        }
      },
      "description": "gen_ai.server.request.duration は opentelemetry プラグインの metrics.enable_latency_metrics が true のときだけ出る。"
    },
    {
      "id": 6,
      "type": "stat",
      "title": "エラー率",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "sum(increase(gen_ai_client_operation_duration_seconds_count{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\", error_type!=\"\"}[$__range])) / clamp_min(sum(increase(gen_ai_client_operation_duration_seconds_count{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\"}[$__range])), 0.0000001)",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series",
          "legendFormat": "errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "mappings": [],
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 48
        }
      },
      "description": "error.type 属性は metrics.enable_request_metrics が true のときだけ埋まる。"
    },
    {
      "id": 7,
      "type": "stat",
      "title": "キャッシュヒット率",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "sum(increase(kong_gen_ai_llm_cost_total{kong_gen_ai_cache_status=~\"Hit|hit\"}[$__range])) / clamp_min(sum(increase(kong_gen_ai_llm_cost_total[$__range])), 0.0000001)",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series",
          "legendFormat": "hit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 48
        }
      },
      "description": "ai-semantic-cache を有効にしたときだけ kong.gen_ai.cache.status が Hit になる。"
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "モデル別の利用回数",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "sum by (gen_ai_request_model) (increase(gen_ai_client_operation_duration_seconds_count{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\"}[$__range]))",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Konnect の GenAI model usage count 相当。"
    },
    {
      "id": 9,
      "type": "piechart",
      "title": "プロバイダ別の利用回数",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "sum by (gen_ai_provider_name) (increase(gen_ai_client_operation_duration_seconds_count{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\"}[$__range]))",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{gen_ai_provider_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Konnect の GenAI provider usage count 相当。"
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "AI ステータスコード",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "sum by (http_response_status_code) (increase(http_server_request_count_total{kong_service_name=~\"$service\"}[$__range]))",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Konnect の AI status codes 相当。gen_ai.* メトリクスは HTTP ステータスを持たないので、AI の Service に絞った http.server.request.count から取る。"
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Consumer 別のトークン使用量",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "sum by (kong_auth_consumer_name, gen_ai_token_type) (increase(gen_ai_client_token_usage_total{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\", gen_ai_token_type=~\"input|output\"}[$__interval]))",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{kong_auth_consumer_name}} / {{gen_ai_token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Konnect の Consumer token usage 相当。Consumer 属性には metrics.enable_consumer_attribute と、認証プラグインによる Consumer の紐付けが要る。"
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Consumer 別のコスト ($)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
