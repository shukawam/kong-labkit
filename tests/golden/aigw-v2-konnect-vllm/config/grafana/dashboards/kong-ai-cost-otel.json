    {
      "id": 7,
      "type": "timeseries",
      "title": "試算コストの推移（モデル別）",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "((sum by (gen_ai_response_model) (increase(gen_ai_client_token_usage_total{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\", gen_ai_token_type=\"input\"}[$__interval]))) * $price_input + (sum by (gen_ai_response_model) (increase(gen_ai_client_token_usage_total{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\", gen_ai_token_type=\"output\"}[$__interval]))) * $price_output) / 1000000",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{gen_ai_response_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
