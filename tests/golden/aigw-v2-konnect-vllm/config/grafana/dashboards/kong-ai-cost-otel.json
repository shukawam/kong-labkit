{
  "uid": "kong-ai-cost-otel",
  "title": "Kong AI Gateway コスト (OpenTelemetry)",
  "description": "AI の利用コストに絞ったダッシュボード。トークン数と単価からの試算を主とし、Kong が計算した kong.gen_ai.llm.cost は参考値として併記する。",
  "tags": [
    "kong",
    "opentelemetry",
    "ai",
    "cost"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds",
        "label": "Datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "regex": "",
        "multi": false,
        "includeAll": false
      },
      {
        "type": "query",
        "name": "provider",
        "label": "Provider",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "definition": "label_values(gen_ai_client_operation_duration_seconds_count,gen_ai_provider_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(gen_ai_client_operation_duration_seconds_count,gen_ai_provider_name)",
          "refId": "provider"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": ""
      },
      {
        "type": "query",
        "name": "model",
        "label": "Model",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "definition": "label_values(gen_ai_client_operation_duration_seconds_count,gen_ai_request_model)",
        "query": {
          "qryType": 1,
          "query": "label_values(gen_ai_client_operation_duration_seconds_count,gen_ai_request_model)",
          "refId": "model"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": ""
      },
      {
        "type": "query",
        "name": "consumer",
        "label": "Consumer",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "definition": "label_values(gen_ai_client_operation_duration_seconds_count,kong_auth_consumer_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(gen_ai_client_operation_duration_seconds_count,kong_auth_consumer_name)",
          "refId": "consumer"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": ""
      },
      {
        "type": "textbox",
        "name": "price_input",
        "label": "入力単価 ($/1M tokens)",
        "query": "1.25",
        "hide": 0,
        "current": {
          "text": "1.25",
          "value": "1.25"
        },
        "options": [
          {
            "selected": true,
            "text": "1.25",
            "value": "1.25"
          }
        ],
        "description": "実際に使っているモデルの単価に書き換える。ai-proxy-advanced の input_cost と同じ単位。"
      },
      {
        "type": "textbox",
        "name": "price_output",
        "label": "出力単価 ($/1M tokens)",
        "query": "10",
        "hide": 0,
        "current": {
          "text": "10",
          "value": "10"
        },
        "options": [
          {
            "selected": true,
            "text": "10",
            "value": "10"
          }
        ],
        "description": "実際に使っているモデルの単価に書き換える。ai-proxy-advanced の output_cost と同じ単位。"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "コスト試算（トークン単価ベース）",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "期間内の試算コスト",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "((sum(increase(gen_ai_client_token_usage_total{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\", gen_ai_token_type=\"input\"}[$__range]))) * $price_input + (sum(increase(gen_ai_client_token_usage_total{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\", gen_ai_token_type=\"output\"}[$__range]))) * $price_output) / 1000000",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series",
          "legendFormat": "estimate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 44
        }
      },
      "description": "上部の $price_input / $price_output（100 万トークンあたりの USD）に実際の単価を入れて使う。Kong が出す kong.gen_ai.llm.cost は OTLP 上で整数に丸められ、1 ドル未満が 0 になってしまうため、金額はこちらを主に見る。"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "試算 $/時",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "((sum(rate(gen_ai_client_token_usage_total{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\", gen_ai_token_type=\"input\"}[$__rate_interval]))) * $price_input + (sum(rate(gen_ai_client_token_usage_total{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\", gen_ai_token_type=\"output\"}[$__rate_interval]))) * $price_output) / 1000000 * 3600",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series",
          "legendFormat": "per hour"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 44
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "30 日換算の見込み",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "((sum(rate(gen_ai_client_token_usage_total{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\", gen_ai_token_type=\"input\"}[$__range]))) * $price_input + (sum(rate(gen_ai_client_token_usage_total{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\", gen_ai_token_type=\"output\"}[$__range]))) * $price_output) / 1000000 * 86400 * 30",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series",
          "legendFormat": "per 30d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 44
        }
      },
      "description": "表示期間の平均消費レートをそのまま 30 日に伸ばした値。トラフィックの偏りは織り込まない。"
    },
    {
      "id": 5,
      "type": "stat",
      "title": "リクエスト 1 件あたり",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 15,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "(((sum(increase(gen_ai_client_token_usage_total{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\", gen_ai_token_type=\"input\"}[$__range]))) * $price_input + (sum(increase(gen_ai_client_token_usage_total{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\", gen_ai_token_type=\"output\"}[$__range]))) * $price_output) / 1000000) / clamp_min(sum(increase(gen_ai_client_operation_duration_seconds_count{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\"}[$__range])), 0.0000001)",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series",
          "legendFormat": "per request"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 6
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 44
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "課金対象トークン数",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "sum(increase(gen_ai_client_token_usage_total{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", kong_auth_consumer_name=~\"$consumer\", gen_ai_token_type=\"total\"}[$__range]))",
          "range": true,
          "instant": false,
          "refId": "A",
