  "required": [
    "customer",
    "gateway"
  ],
  "title": "kong-labkit env spec",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "キーと値の候補だけを表す。組み合わせの検証は generator/schema.py の model_validator が担当するので、ここを通っても生成が失敗することはある。"
}
