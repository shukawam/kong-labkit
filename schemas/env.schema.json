{
  "$defs": {
    "AiSpec": {
      "additionalProperties": false,
      "properties": {
        "providers": {
          "items": {
            "$ref": "#/$defs/Provider"
          },
          "title": "Providers",
          "type": "array"
        },
        "semantic_cache": {
          "default": false,
          "title": "Semantic Cache",
          "type": "boolean"
        },
        "semantic_routing": {
          "default": false,
          "title": "Semantic Routing",
          "type": "boolean"
        },
        "embedding_model": {
          "default": "text-embedding-3-large",
          "title": "Embedding Model",
          "type": "string"
        },
        "prompt_guard": {
          "$ref": "#/$defs/PromptGuardMode",
          "default": "none"
        },
        "prompt_compressor": {
          "default": false,
          "title": "Prompt Compressor",
          "type": "boolean"
        }
      },
      "title": "AiSpec",
      "type": "object"
    },
    "AuthType": {
      "enum": [
        "api-key",
        "managed-identity",
        "session-token"
      ],
      "title": "AuthType",
      "type": "string"
