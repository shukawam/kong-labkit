    "idp": {
      "$ref": "#/$defs/IdpSpec"
    },
    "cache": {
      "$ref": "#/$defs/CacheSpec"
    },
    "vectordb": {
      "$ref": "#/$defs/VectorDbSpec"
    },
    "observability": {
      "$ref": "#/$defs/ObservabilitySpec"
    },
    "secrets": {
      "$ref": "#/$defs/SecretsSpec"
    },
