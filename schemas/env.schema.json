          "default": "/upstream",
          "title": "Route Path",
          "type": "string"
        },
        "strip_path": {
          "default": true,
          "title": "Strip Path",
          "type": "boolean"
        },
        "smoke": {
          "$ref": "#/$defs/UpstreamSmokeSpec"
        }
